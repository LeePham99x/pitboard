// Workers static assets. No routes or custom_domain here: a deploy from this file must never
// touch usepitboard.com's DNS or its redirect rules.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pitboard-website",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
