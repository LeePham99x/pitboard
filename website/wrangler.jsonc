{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pitboard",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "previews": {},
}
