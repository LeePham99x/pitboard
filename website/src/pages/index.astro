---
import Base from "../layouts/Base.astro";
import Block from "../components/Block.astro";
import Disclosure from "../components/Disclosure.astro";
import Icons from "../components/Icons.astro";
import InstallTabs from "../components/InstallTabs.astro";
import Accounts from "../components/fig/Accounts.astro";
import Activity from "../components/fig/Activity.astro";
import Desk from "../components/fig/Desk.astro";
import Figure from "../components/fig/Figure.astro";
import Notice from "../components/fig/Notice.astro";
import OpenLink from "../components/fig/OpenLink.astro";
import Settings from "../components/fig/Settings.astro";
import Term from "../components/fig/Term.astro";
import Feature from "../components/home/Feature.astro";
import Row from "../components/home/Row.astro";
import { sessions } from "../data/sessions.ts";
import { DOCS, REPO } from "../data/site.ts";
import { longDate } from "../lib/changelog.ts";
import { appZip } from "../lib/github.ts";
import { highlight, siteData } from "../lib/data.ts";
import { tools } from "../data/world.ts";
import { statusLine } from "../lib/words.ts";

const { versions, release } = await siteData();
const zip = appZip(release);
const recent = versions.slice(0, 3).map((v) => ({ ...v, highlight: highlight(v.version) }));
// a row is one string: on a phone its cells run inline, where whitespace between them would show
const cell = "border-b border-grid py-3.5 text-left align-baseline max-sm:border-0 max-sm:p-0";
const row = (v: (typeof recent)[number]) =>
  `<th class="${cell} pr-6 font-mono text-control font-semibold whitespace-nowrap max-sm:mr-3 max-sm:inline" scope="row"><a href="/changelog#v${v.version}">${v.version}</a></th><td class="${cell} pr-6 text-note/[1.5] whitespace-nowrap text-muted max-sm:inline">${longDate(v.date)}</td><td class="${cell} max-sm:mt-1 max-sm:block">${v.highlight}</td>`;
const note = "mt-4 hidden max-w-measure text-note text-pretty text-muted";
const guide = { claude: "claude-code", codex: "codex", desktop: "claude-desktop" };

const faq = [
  {
    q: "What does Pitboard work with?",
    a: "Claude Code signed in to a Claude account, OpenAI's Codex CLI signed in with ChatGPT, and Claude Desktop on macOS. Pitboard does not support API keys, third-party providers or Gemini CLI.",
    link: [
      `${DOCS}/concepts/limits#tools-and-sign-ins-pitboard-does-not-support`,
      "Tools and sign-ins Pitboard does not support",
    ],
  },
  {
    q: "Is this allowed?",
    a: "Anthropic's and OpenAI's terms decide that. Pitboard moves only your own logins and cannot share an account between people.",
    link: [`${DOCS}/concepts/limits#is-this-allowed`, "Is this allowed"],
  },
  {
    q: "Why not use <code>/login</code> or <code>codex login</code>?",
    a: "Both replace the login in use, so the account you leave needs a browser sign-in again. <code>codex login</code> also revokes the login it replaces.",
    link: [`${DOCS}/guides/accounts#add-another-account`, "Add another account"],
  },
  {
    q: "Does Pitboard see my prompts?",
    a: "No. Pitboard never sees a tool's requests and sends no model request of its own: a warm-up is Claude Code's own.",
    link: [`${DOCS}/concepts/limits#rules`, "Rules"],
  },
  {
    q: "Does it run on Linux or Windows?",
    a: "The command line runs on Linux, but it has not been run there with real logins. There is no Windows release.",
    link: [`${DOCS}/install#what-you-need`, "What you need"],
  },
  {
    q: "What happens if I uninstall it?",
    a: "<code>pitboard uninstall</code> turns off daily renewal and deletes every parked login, then <code>~/.pitboard</code>. Each tool stays signed in to its account in use, and every other account needs signing in again.",
    link: [`${DOCS}/install/remove#delete-parked-logins-first`, "Delete parked logins first"],
  },
  {
    q: "Can I script it?",
    a: "Yes. With <code>--json</code>, every command prints one line of JSON, with a stable code for each error.",
    link: [`${DOCS}/reference/json-output#the-envelope`, "The envelope"],
  },
  {
    q: "Is Pitboard made by Anthropic or OpenAI?",
    a: "No. Pitboard is not affiliated with Anthropic or OpenAI, and one person maintains it.",
    link: [`${REPO}/blob/main/NOTICE`, "NOTICE"],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Pitboard",
    url: new URL("/", Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Pitboard",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS 14 or later, Linux",
    softwareVersion: release.version,
    downloadUrl: zip.url,
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    url: new URL("/", Astro.site).href,
  },
];
---

<Base
  title="Pitboard: switch AI coding tools between your accounts"
  description="Switch your AI coding tools between your own accounts without signing out, and see what each account has left."
  current="home"
  path="/"
  jsonLd={jsonLd}
>
  <Icons slot="defs" />
  <main id="main">
    <section class="pt-14" aria-labelledby="hero-title">
      <div
        class="wrap grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-x-12 max-xl:grid-cols-[minmax(0,1fr)]"
      >
        <div class="pt-6">
          <h1 class="font-mono text-h1 text-strong max-sm:text-h1-sm" id="hero-title">Pitboard</h1>
          <p class="mt-4 max-w-lead text-lead text-pretty text-fg max-sm:text-lead-sm">
            Switch your AI coding tools between your own accounts without signing out.
          </p>
          <p class:list={[note, "os-linux:block"]}>
            On Linux, Pitboard has not been run with real logins.
          </p>
          <p class:list={[note, "os-windows:block"]}>
            There is <a href={`${DOCS}/install#what-you-need`}>no Windows release</a>.
          </p>
          <p class:list={[note, "os-mobile:block"]}>Pitboard runs on a Mac or a Linux computer.</p>
          <InstallTabs class="mt-10" n={1} zipUrl={zip.url} />
          <div class="mt-10 border-t border-grid pt-5 font-mono text-ui">
            <p class="text-muted">Works with</p>
            <ul class="mt-2 flex flex-wrap gap-x-7 gap-y-1">
              {tools.map(([tool, name]) => <li>
                <a href={`${DOCS}/guides/${guide[tool]}`}>{name}</a>
                {tool === "desktop" && <span class="text-muted">on macOS</span>}
              </li>)}
            </ul>
          </div>
        </div>
        <Figure
          class="mt-8.75 max-xl:mt-8"
          pick={false}
          app={{
            caption: "Switching accounts in Pitboard's menu.",
            describe:
              "Pitboard's menu open from the menu bar. Claude Code has personal, in use, and work; Codex has main, in use, and spare; Claude Desktop has home, in use, and office. Each Claude Code and Codex account shows its plan and how much of each limit it has used, and each Claude Desktop account reads No usage read. The pointer chooses work and the menu closes; the menu bar shows work 40%. The pointer opens the menu again, with work first and in use. Then the status line of the Claude Code session behind the menu puts work first.",
          }}
          cli={{
            caption: "The same accounts in a terminal.",
            describe:
              "<code>pitboard</code> in a terminal lists the Claude Code accounts work, in use, and personal, then the Codex accounts main, in use, and spare. Each limit has a bar, how much is used, when it resets and its pace. Then Claude Desktop, whose usage Pitboard does not read: home, in use, read 2h 05m ago, and office, whose sign-in may lapse in 25 days 3 hours.",
          }}
        >
          <Desk demo />
          <Term slot="cli" session={sessions.status} />
        </Figure>
      </div>
    </section>
    <Feature id="switch" title="Switch without signing out">
      <p>
        Choose an account in the menu, or run <code>pitboard use work</code>. History, settings and
        projects stay where they are.
      </p>
      <p>
        Pitboard keeps the login of each account not in use, called a parked login.
        <a href={`${DOCS}/guides/renewal`}>Daily renewal</a> keeps Claude Code's parked logins from
        expiring, whether the app is open or not.
      </p>
      <p>
        <a href={`${DOCS}/guides/switch#what-happens-to-open-sessions`}
          >Claude Code sessions already open follow the switch</a
        >. Restart anything that runs Codex; the app offers to quit the ChatGPT app and open it
        again.
      </p>
      <p>
        <a href={`${DOCS}/guides/accounts#add-another-account`}
          >Adding a Claude Code or Codex account</a
        >
        opens the tool's own sign-in, and the account in use stays signed in. Each organisation your
        Anthropic account belongs to counts as a separate account.
      </p>
      <p><b>Sign In Again</b> does the same for a parked login that stopped working.</p>
      <Figure
        slot="fig"
        app={{
          caption: "The Pitboard window after the switch.",
          describe:
            "The top of the Accounts pane after a switch. A notice, Switched Claude Code to work, counts down: Claude Code sessions already open follow in 0:21. Under it, work is in use.",
        }}
        cli={{
          caption: "Switching from a terminal.",
          describe:
            "<code>pitboard use work</code> prints: Switched to work; personal is parked. Claude Code sessions already running follow within 33 seconds.",
        }}
      >
        <Accounts moment="after" crop />
        <Term slot="cli" session={sessions.use} />
      </Figure>
    </Feature>
    <Feature id="desktop" title="Claude Desktop">
      <p>
        On macOS, Pitboard switches <a href={`${DOCS}/guides/claude-desktop`}>Claude Desktop</a>
        between your accounts too, from the menu or with <code>pitboard use desktop/home</code>.
      </p>
      <p>
        It changes Claude's login only while Claude is closed. The app offers to quit Claude,
        switches, and opens it again.
      </p>
      <p>
        Pitboard
        <a href={`${DOCS}/concepts/claude-desktop#what-pitboard-does-not-do-for-claude-desktop`}
          >reads no usage for Claude Desktop</a
        >. It never switches Claude Desktop by itself and never renews its parked logins.
      </p>
      <Figure
        slot="fig"
        app={{
          caption: "Claude Desktop in the Pitboard window.",
          describe:
            "The Claude Desktop section of the Accounts pane. home is in use: Read 2h 05m ago, with Claude closed. office has a Use button: Its sign-in may lapse in 25 days.",
        }}
        cli={{
          caption: "Switching Claude Desktop from a terminal.",
          describe:
            "<code>pitboard use desktop/home</code> prints: Switched to desktop/home; desktop/office is parked. Claude opens signed in to it.",
        }}
      >
        <Accounts moment="after" only="desktop" />
        <Term slot="cli" session={sessions.useDesktop} />
      </Figure>
    </Feature>

    <Feature id="usage" title="What each account has left">
      <p>
        Pitboard shows every limit of every Claude Code and Codex account: how much is used and when
        it resets.
      </p>
      <p>
        A mark on each bar shows where <a href={`${DOCS}/concepts/usage#pace`}>an even pace</a>
        would have reached. For the account in use, Pitboard says which limit runs out first.
      </p>
      <p>
        <a href={`${DOCS}/reference/app#menu-bar-item`}>The menu bar</a> shows the account in use
        and how much of its fullest limit is used.
      </p>
      <p>
        With <a href={`${DOCS}/guides/status-line`}><code>pitboard statusline</code></a> in Claude
        Code's settings, each session shows the usage of every Claude Code account:
      </p>
      <pre
        class="w-fit max-w-full overflow-x-auto rounded-md border border-grid bg-term-bg px-3.5 py-2.5 font-mono text-ui whitespace-pre text-term-text [&_.dim]:text-term-dim [&_.g]:text-term-green [&_.r]:text-term-red [&_.y]:text-term-yellow [&_b]:text-term-bold"
        data-output
        set:html={statusLine("before")}
      />
      <Figure
        slot="fig"
        app={{
          caption: "The Pitboard window.",
          describe:
            "The Accounts pane of the Pitboard window. personal is in use, with its weekly limit at 73% and 55% over pace, and the line: Weekly limit runs out in 11h 05m at this pace. work's parked login is good for 26 more days. Codex's main and spare follow, then Claude Desktop's home and office.",
        }}
        cli={{
          caption: "The same accounts in a terminal.",
          describe:
            "<code>pitboard</code> lists the Claude Code accounts personal, in use, with its weekly limit running out in 11 hours 5 minutes at this pace, and work, ready, its parked login good for 26 days 4 hours. Then the Codex accounts main, in use, and spare, and the Claude Desktop accounts home and office.",
        }}
      >
        <Accounts moment="before" />
        <Term slot="cli" session={sessions.statusBefore} />
      </Figure>
    </Feature>

    <section class="pt-(--block-space)" aria-labelledby="runs-out-title" id="runs-out">
      <div class="wrap">
        <h2
          class="border-t border-rule pt-(--block-in) font-mono text-h2 text-balance text-strong max-sm:text-h2-sm"
          id="runs-out-title"
        >
          Before an account runs out
        </h2>
        <Row id="offer-title" title="When one runs out">
          <p>
            <a href={`${DOCS}/guides/switch#when-an-account-runs-out`}
              >When the account in use runs out</a
            >
            of a limit, the app offers another with room left. Its notification has a <b>Switch</b>
            button.
          </p>
          <Figure
            slot="fig"
            app={{
              caption: "The notification when an account runs out.",
              describe:
                "A notification from Pitboard: personal has no weekly limit left. Claude Code. work has 60% of its own left. It has a Switch button.",
            }}
          >
            <Notice />
          </Figure>
        </Row>
        <Row id="auto-title" title="Automatic switch" flip>
          <p>
            Pitboard can
            <a href={`${DOCS}/guides/automatic-switching`}>switch Claude Code by itself</a> once a
            limit of the account in use reaches a set share.
          </p>
          <p>An account without a weekly limit for all models, such as a Team seat, goes first.</p>
          <p>
            It never switches Codex, and runs only while the app is open or
            <code>pitboard watch</code> runs.
          </p>
          <Figure
            slot="fig"
            app={{
              caption: "Settings, in the Limits pane.",
              describe:
                "The Limits pane of Pitboard's Settings, with Switch Claude Code automatically turned on and Switch when a limit reaches 95%. Under it: Watching work: 40% of its weekly limit, as of 20:50.",
            }}
            cli={{
              caption: "The same from a terminal.",
              describe:
                "<code>pitboard watch</code> prints that it switches to another account once a limit of the one in use reaches 95%, and warms up personal from 07:00 to 23:00, then: Watching work: 40% of its weekly limit, as of 20:50.",
            }}
          >
            <Settings show="switch" />
            <Term slot="cli" session={sessions.watch} />
          </Figure>
        </Row>
        <Row id="warm-title" title="Warm-up">
          <p>
            When a five-hour period ends, a <a href={`${DOCS}/guides/warm-up`}>warm-up</a> has
            Claude Code send one short message. The next period then resets as early as it can.
          </p>
          <p>It spends a little of the plan, for the Claude Code accounts you turn it on for.</p>
          <p>
            It runs only while the app is open or <code>pitboard watch</code> runs, within the hours
            you set.
          </p>
          <Figure
            slot="fig"
            app={{
              caption: "Warm-up in the Limits pane.",
              describe:
                "Warm up limits, from 07:00 to 23:00. personal is turned on and warms up again at 22:00; work is off. Next warm-up: personal at 22:00.",
            }}
            cli={{
              caption: "The same from a terminal.",
              describe:
                "<code>pitboard warm</code> says Pitboard warms up these accounts from 07:00 to 23:00: personal on, warms up again at 22:00; work off.",
            }}
          >
            <Settings show="warm" />
            <Term slot="cli" session={sessions.warm} />
          </Figure>
        </Row>
      </div>
    </section>

    <Feature id="windows" title="claude.ai and chatgpt.com for each account">
      <p>
        The app opens claude.ai or chatgpt.com
        <a href={`${DOCS}/guides/account-windows`}>in a window for each account</a>, and each window
        keeps its own sign-in.
      </p>
      <p>
        You sign in once in each window, on the site's own pages.
        <a href={`${DOCS}/guides/account-windows#what-a-window-cannot-do`}
          >Google sign-in and passkeys do not work there</a
        >.
      </p>
      <p>
        <a href={`${DOCS}/guides/account-windows#open-a-page-from-your-browser`}
          >Share a claude.ai or chatgpt.com page</a
        >
        from Safari, Chrome or Firefox to open it as one of your accounts.
      </p>
      <Figure
        slot="fig"
        app={{
          caption: "Opening a shared link as an account.",
          describe:
            "The Open Link window: Open this claude.ai link as: personal, or work, whose window is open. work is chosen, with Cancel and Open buttons.",
        }}
      >
        <OpenLink />
      </Figure>
    </Feature>

    <Feature id="security" title="Security and privacy">
      <p>
        Pitboard has no server of its own and no telemetry. The docs
        <a href={`${DOCS}/security#what-leaves-your-machine`}>list every request it makes</a>.
      </p>
      <p>
        <a href={`${DOCS}/security#where-parked-logins-are-kept`}>Parked logins</a> stay in your
        keychain on macOS and in files on Linux, and a Claude Desktop one in a folder only you can
        open. A login goes only to the service that issued it.
      </p>
      <p>
        A Claude Code or Codex <a href={`${DOCS}/concepts/switching#what-a-switch-does`}>switch</a>
        first checks whose login is in use and that the next one still works.
      </p>
      <p>
        <b>This Mac</b> and <code>pitboard doctor</code> check what Pitboard relies on.
        <b>Activity</b> and <code>pitboard log</code>
        <a href={`${DOCS}/reference/maintenance-commands#log`}>list every change</a> it makes.
      </p>
      <p>
        <a href={`${REPO}/blob/main/SECURITY.md#out-of-scope`}
          >Read what Pitboard does not protect against</a
        >.
      </p>
      <Figure
        slot="fig"
        app={{
          caption: "The Activity pane.",
          describe:
            "The Activity pane of the Pitboard window lists the switch to work, the switch to desktop/home and a warm-up of personal, all asked by the Pitboard app, and the enrolment of work from the command line, each Done.",
        }}
        cli={{
          caption: "The same from a terminal.",
          describe:
            "<code>pitboard log</code> lists the enrolment of work, a warm-up of personal, the switch to desktop/home and the switch to work, each ok.",
        }}
      >
        <Activity />
        <Term slot="cli" session={sessions.log} />
      </Figure>
    </Feature>

    <Block titleId="releases-title" title="Recent releases">
      <div>
        <table
          class="w-full border-collapse text-table max-sm:block"
          aria-labelledby="releases-title"
        >
          <tbody class="max-sm:block">
            {recent.map((v) => (
              <tr
                class="max-sm:block max-sm:border-b max-sm:border-grid max-sm:py-3.5"
                set:html={row(v)}
              />
            ))}
          </tbody>
        </table>
        <p class="mt-5"><a href="/changelog">All releases</a></p>
      </div>
    </Block>

    <Block titleId="faq-title" title="Questions">
      <div>
        {faq.map((item) => <Disclosure summary={item.q}>
          <p set:html={item.a} />
          <p>
            <a href={item.link[0]}>{item.link[1]}</a>
          </p>
        </Disclosure>)}
      </div>
    </Block>

    <Block titleId="install-title" title="Install Pitboard">
      <div>
        <InstallTabs n={2} zipUrl={zip.url} />
      </div>
    </Block>
  </main>
</Base>
