---
import Base from "../layouts/Base.astro";
import { compareBase, longDate, monthOf } from "../lib/changelog.ts";
import { siteData } from "../lib/data.ts";
import { REPO, SPONSOR } from "../data/site.ts";

const { versions } = await siteData();
const entries = versions.map((v, i) => {
  const month = monthOf(v.date);
  const from = compareBase(v.link);
  return {
    ...v,
    id: `v${v.version}`,
    month: i === 0 || monthOf(versions[i - 1].date) !== month ? month : null,
    files: `${REPO}/releases/tag/v${v.version}`,
    // a first release links its tag, which Files and checksums already does
    other: from
      ? { href: v.link, text: `Changes since ${from}` }
      : v.link !== `${REPO}/releases/tag/v${v.version}`
        ? { href: v.link, text: "Release" }
        : null,
  };
});
---

<Base
  title="Pitboard changelog"
  description="What each Pitboard release added, changed and fixed, newest first."
  current="changelog"
  path="/changelog"
>
  <main id="main">
    <div
      class="wrap grid grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-x-12 pt-14 max-lg:grid-cols-[minmax(0,1fr)] max-lg:pt-12 max-sm:pt-8"
    >
      <h1 class="col-span-full font-mono text-h1 text-strong max-sm:text-h1-sm">Changelog</h1>

      <nav
        class="col-start-1 row-start-3 pt-44 max-lg:-mx-(--gutter) max-lg:row-auto max-lg:border-b max-lg:border-grid max-lg:pt-10"
        aria-label="Versions"
      >
        <div
          class="sticky top-24 -mx-2 max-h-[calc(100vh-128px)] overflow-y-auto px-2 [scrollbar-width:thin] max-lg:static max-lg:m-0 max-lg:max-h-none max-lg:overflow-x-auto max-lg:overflow-y-hidden max-lg:pr-12 max-lg:pl-(--gutter) max-lg:[mask-image:linear-gradient(to_left,transparent,#000_48px)]"
          id="rail"
        >
          <ul class="max-lg:flex max-lg:w-max max-lg:gap-7">
            {entries.map((e) => <li>
              <a
                class="-mx-1.5 block w-fit px-1.5 py-0.75 font-mono text-ui/6 font-medium text-fg no-underline tabular-nums hover:text-ink hover:underline hover:decoration-auto hover:decoration-current hover:underline-offset-4 focus-visible:-outline-offset-2 aria-[current]:font-bold aria-[current]:text-ink max-lg:py-2.5 max-lg:text-control"
                href={`#${e.id}`}
                data-v={e.id}
              >
                {e.version}
              </a>
            </li>)}
          </ul>
        </div>
      </nav>

      <div
        class="col-start-2 row-start-3 min-w-0 max-w-measure pt-24 max-lg:col-start-1 max-lg:row-auto max-lg:pt-14"
      >
        {entries.map((e, i) => (
          <>
            {e.month && <p
              class:list={[
                "mb-4 font-mono text-control font-medium text-muted",
                { "mt-28 max-sm:mt-20": i > 0 },
              ]}
            >
              {e.month}
            </p>}
            <article
              class:list={[
                "border-t border-rule pt-7",
                { "mt-28 max-sm:mt-20": i > 0 && !e.month },
              ]}
              id={e.id}
              aria-labelledby={`${e.id}-h`}
            >
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
                <h2
                  class="font-mono text-h2 text-strong ligatures-none max-sm:text-h2-sm"
                  id={`${e.id}-h`}
                >
                  {e.version}
                </h2>
                <time class="font-mono text-control text-muted" datetime={e.date}>
                  {longDate(e.date)}
                </time>
                {e.prerelease && <span class="font-mono text-control text-muted">Pre-release</span>}
              </div>
              {e.intro && (
                <div class="changelog-md mt-6" data-source="changelog" set:html={e.intro} />
              )}
              {e.sections.map((s) => <div class="mt-10 max-sm:mt-8">
                <h3 class="font-mono text-note/6 font-bold text-strong" id={s.id}>
                  {s.kind}
                </h3>
                <div class="changelog-md mt-4" data-source="changelog" set:html={s.html} />
              </div>)}
              <div
                class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-mono text-control font-medium max-sm:gap-x-6 max-sm:text-ui/6"
              >
                <a href={e.files}>Files and checksums</a>
                {e.other && <a href={e.other.href}>{e.other.text}</a>}
                <button
                  class="h-7 cursor-pointer rounded-sm border border-edge px-2.5 font-mono text-label font-medium text-strong hover:bg-sunken no-js:hidden"
                  type="button"
                  id={`${e.id}-copy`}
                  aria-labelledby={`${e.id}-copy ${e.id}-h`}
                  data-copy={new URL(`/changelog#${e.id}`, Astro.site).href}
                >
                  Copy link
                </button>
              </div>
            </article>
          </>
        ))}

        <div class="prose mt-28 border-t border-rule pt-(--block-in) max-sm:mt-20">
          <p>
            Follow releases with the <a href="/changelog/rss.xml">RSS feed</a>. Release candidates
            are only on <a href={`${REPO}/releases`}>GitHub Releases</a>.
          </p>
          <p>
            This page is built from
            <a href={`${REPO}/blob/main/CHANGELOG.md`}><code>CHANGELOG.md</code></a>.
          </p>
          <p><a href={SPONSOR}>Sponsor Pitboard on GitHub</a>.</p>
        </div>
      </div>
    </div>
  </main>
  <script>
    import "../scripts/changelog.ts";
  </script></Base>
