---
import Base from "../layouts/Base.astro";
import "../styles/download.css";
import CommandBox from "../components/CommandBox.astro";
import { attestCommand, commands } from "../data/commands.ts";
import { DOCS, SITE } from "../data/site.ts";
import { escapeHtml, longDate } from "../lib/changelog.ts";
import { appZip, fileRows, formatSize, type Asset } from "../lib/github.ts";
import { siteData } from "../lib/data.ts";

const { release, latest } = await siteData();
const zip = appZip(release);
const rows = fileRows(release);
const ways = [
  ["With cargo-binstall", commands.binstall],
  ["From source, with Rust 1.91 or later and a C compiler", commands.cargoInstall],
  ["Without curl", commands.wget],
  ["Into another folder", commands.installDir],
] as const;
// Cells written as one string: on a phone their text follows a label drawn by CSS, so a space
// from the template's line breaks would show.
const none = '<span class="none">None</span>';
const shaCell = (a: Asset) =>
  a.sha256
    ? `<code class="sha">${a.sha256.slice(0, 12)}<span class="vh">${a.sha256.slice(12)}</span></code><button class="btn-quiet" type="button" data-copy="${a.sha256}" aria-label="Copy the SHA-256 of ${escapeHtml(a.name)}">Copy</button>`
    : none;
const bomCell = (b: Asset | null) =>
  b ? `<a href="${escapeHtml(b.url)}"><code>.cdx.json</code></a>, ${formatSize(b.size)}` : none;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Pitboard",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS 14 or later, Linux",
    softwareVersion: release.version,
    downloadUrl: zip.url,
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    url: `${SITE}/download`,
  },
];
---

<Base
  title="Download Pitboard for macOS and Linux"
  description="Download the Pitboard app for macOS and the command line for macOS and Linux."
  current="download"
  path="/download"
  jsonLd={jsonLd}
>
  <main id="main" class="dl">
    <div class="wrap dl-head">
      <h1 class="h1">Download Pitboard</h1>
      <div class="dl-ver">
        <p>Version {release.version}, released <span class="nw">{longDate(latest.date)}</span></p>
        <p><a href={`/changelog#v${release.version}`}>Release notes</a></p>
      </div>
    </div>

    <div class="dl-get">
      <div class="wrap dl-cols">
        <section class="dl-col" id="app" aria-labelledby="app-title">
          <h2 class="h2" id="app-title">App</h2>
          <div class="dl-body">
            <p class="dl-linux">The app is for macOS; on Linux, use the command line.</p>
            <div><a class="btn" href={zip.url}>Download for Mac</a></div>
            <p class="note">
              <code>{zip.name}</code>, <span class="nw">{formatSize(zip.size)}</span>
            </p>
            <p class="dl-req">The app needs macOS 14 or later, on Apple silicon or Intel.</p>
            <p>
              Move Pitboard to your Applications folder before you open it. Opened elsewhere, it
              cannot turn on daily renewal or install its command line.
            </p>
            <p class="cmd-lead">Or install it with Homebrew:</p>
            <CommandBox command={commands.brewApp} />
            <p>
              The app includes the command line, so install one or the other. <b>Settings</b> &gt;
              <b>Command Line</b> puts it on your <code>PATH</code>.
            </p>
          </div>
        </section>

        <section class="dl-col" id="command-line" aria-labelledby="cli-title">
          <h2 class="h2" id="cli-title">Command line</h2>
          <div class="dl-body">
            <p>
              The command line runs on Apple silicon and Intel Macs, and on x86_64 and aarch64
              Linux.
            </p>
            <p>
              On Linux, Pitboard builds and passes its tests but has not been run with real logins.
            </p>
            <CommandBox command={commands.installScript} />
            <p>
              The script puts the command line of the most recent release in
              <code>~/.local/bin</code>. It skips release candidates and changes no shell profile.
            </p>
            <p>
              <a href={`${DOCS}/install/verify#check-the-install-script`}
                >Check the script before you run it</a
              >.
            </p>
            <p class="cmd-lead">Or install it with Homebrew:</p>
            <CommandBox command={commands.brewCli} />
            <details class="qa" id="other-ways">
              <summary>Other ways to install</summary>
              <div class="qa-a ways-box">
                <table class="ways" role="table">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th scope="col" role="columnheader">Way</th>
                      <th scope="col" role="columnheader">Command</th>
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    {ways.map(([way, command]) => <tr role="row">
                      <th scope="row" role="rowheader">
                        {way}
                      </th>
                      <td role="cell">
                        <CommandBox command={command} />
                      </td>
                    </tr>)}
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        </section>
      </div>
    </div>

    <section class="block" id="release-files" aria-labelledby="files-title">
      <div class="wrap">
        <div class="block-in one">
          <h2 class="h2" id="files-title">Release files</h2>
          <div>
            <table class="tbl files" role="table">
              <caption class="vh">
                Files of Pitboard{release.version}
              </caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">File</th>
                  <th scope="col" role="columnheader">For</th>
                  <th scope="col" role="columnheader">Size</th>
                  <th scope="col" role="columnheader">SHA-256</th>
                  <th scope="col" role="columnheader">Bill of materials</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {rows.map(({ asset, forHtml, bom }) => <tr role="row">
                  <th scope="row" role="rowheader">
                    <a href={asset.url}><code>{asset.name}</code></a>
                  </th>
                  <td class="f-for" role="cell" set:html={forHtml} />
                  <td class="f-size" role="cell">
                    {formatSize(asset.size)}
                  </td>
                  <td class="f-sha" role="cell" set:html={shaCell(asset)} />
                  <td class="f-bom" role="cell" set:html={bomCell(bom)} />
                </tr>)}
              </tbody>
            </table>
            <p class="note dl-files-note">
              Each tarball unpacks into a folder named like the tarball.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="verify" aria-labelledby="verify-title">
      <div class="wrap">
        <div class="block-in">
          <h2 class="h2" id="verify-title">Verify a download</h2>
          <div class="prose">
            <p>
              Every release file has a GitHub attestation. To check one, run this in its folder,
              signed in to <code>gh</code>:
            </p>
            <CommandBox command={attestCommand(zip.name)} />
            <p>
              To compare checksums, verify <code>SHA256SUMS</code> with <code>gh</code> first, then
              run this on macOS:
            </p>
            <CommandBox command={commands.shasum} />
            <p class="cmd-lead">On Linux:</p>
            <CommandBox command={commands.sha256sum} />
            <p>
              The app and macOS command line are signed by team <code>D7HJ5TFYCU</code> and
              notarised. Linux files are not signed.
            </p>
            <p>The docs <a href={`${DOCS}/install/verify`}>explain each check</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="remove" aria-labelledby="remove-title">
      <div class="wrap">
        <div class="block-in">
          <h2 class="h2" id="remove-title">Remove Pitboard</h2>
          <div class="prose">
            <p>
              Before you <a href={`${DOCS}/install/remove`}>delete Pitboard</a>, quit the app and
              run <code>pitboard uninstall</code>, or its parked logins stay on your computer.
              <code>pitboard uninstall</code> deletes them, so every account not in use needs a
              browser sign-in again.
            </p>
            <p class="note">
              If Homebrew installed Pitboard 0.3.0 or earlier, follow
              <a href={`${DOCS}/install/upgrade-from-0-3-0`}>Upgrade from 0.3.0 or earlier</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="windows" aria-labelledby="windows-title">
      <div class="wrap">
        <div class="block-in">
          <h2 class="h2" id="windows-title">Windows</h2>
          <div class="prose">
            <p>There is no Windows release.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script>
    import "../scripts/download.ts";
  </script></Base>
