---
interface Props {
  href: string;
  // the install tabs show the move-to-Applications step once it is clicked
  after?: boolean;
  class?: string;
}
const { href, after = false, class: extra } = Astro.props;
---

<a
  class:list={[
    "inline-flex h-12 cursor-pointer items-center justify-center rounded-sm bg-ink px-6 font-mono text-control font-semibold text-on-ink no-underline hover:bg-[color-mix(in_srgb,var(--color-ink)_84%,var(--color-page))]",
    extra,
  ]}
  href={href}
  data-download={after ? "" : undefined}
  >Download for Mac</a
>
