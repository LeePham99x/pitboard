---
// With `demo`, it also holds the state before the switch, which site.ts plays once.
import { session, statusNow, statusWas } from "../data/scene.ts";

interface Props {
  demo?: boolean;
}
const { demo = false } = Astro.props;

const shortcut = (keys: string) => [...keys];
const actions: ({ title: string; sub?: string; keys?: string; more?: boolean } | null)[] = [
  { title: "Add Account…", keys: "⌘N" },
  { title: "Refresh", sub: "Updated 20:52", keys: "⌘R" },
  null,
  { title: "Open claude.ai", more: true },
  { title: "Open chatgpt.com", more: true },
  null,
  { title: "Open Pitboard", keys: "⌘0" },
  { title: "Settings…", keys: "⌘," },
  { title: "Check for Updates…" },
  null,
  { title: "About Pitboard" },
  { title: "Pitboard Help" },
  { title: "Quit Pitboard", keys: "⌘Q" },
];
---

<div class="desk" aria-hidden="true" data-output>
  <div class="desk-st">
    <div class="tw">
      <div class="tw-bar">
        <span class="tw-tl"><i></i><i></i><i></i></span><span class="tw-title">claude</span>
      </div>
      <div class="tw-body">
        {session.map((line) => (
          <div set:html={line} />
        ))}
        <div class="tw-rule"></div>
        <div>&gt; <span class="tw-cur"> </span></div>
        <div class="tw-rule"></div>
        {demo ? (
          <>
            <div class="sl-was" set:html={statusWas} />
            <div class="sl-now" set:html={statusNow} />
          </>
        ) : (
          <div set:html={statusNow} />
        )}
      </div>
    </div>
    <div class="mb">
      <div class="mb-pb">
        <div class="mb-i on">
          <svg class="mb-mark"><use href="#pb-template"></use></svg>
          {demo ? (
            <>
              <span class="dm-was">personal 73%</span>
              <span class="dm-now">work 40%</span>
            </>
          ) : (
            "work 40%"
          )}
        </div>
        <div class="mn">
          <div class="mn-h">Claude Code</div>
          <div class:list={["mn-r two", { "r-personal": demo }]}>
            <svg class="mn-ck"><use href="#ic-check"></use></svg
            ><span class="mn-c"
              ><span class="mn-t">personal · Max 20x</span
              ><span class="mn-s"
                >{demo ? (
                  <>
                    <span class="dm-was">5-hour 59%, weekly 73% (runs out in 11h 05m)</span>
                    <span class="dm-now">5-hour 59%, weekly 73%</span>
                  </>
                ) : (
                  "5-hour 59%, weekly 73%"
                )}</span
              ></span
            ><span class="mn-k"></span>
          </div>
          <div class:list={["mn-r two on", { "r-work hl": demo }]}>
            <svg class="mn-ck"><use href="#ic-check"></use></svg
            ><span class="mn-c"
              ><span class="mn-t">work · Team 5x</span
              ><span class="mn-s">5-hour 12%, weekly 40%</span></span
            ><span class="mn-k"></span>
          </div>
          <div class="mn-sep"></div>
          <div class="mn-h">Codex</div>
          <div class="mn-r two on">
            <svg class="mn-ck"><use href="#ic-check"></use></svg
            ><span class="mn-c"
              ><span class="mn-t">main · Pro</span
              ><span class="mn-s">5-hour 18%, weekly 7%</span></span
            ><span class="mn-k"></span>
          </div>
          <div class="mn-r two">
            <svg class="mn-ck"><use href="#ic-check"></use></svg
            ><span class="mn-c"
              ><span class="mn-t">spare · Pro</span><span class="mn-s">5-hour 0%</span></span
            ><span class="mn-k"></span>
          </div>
          <div class="mn-sep"></div>
          {actions.map((a) =>
            a === null ? (
              <div class="mn-sep" />
            ) : (
              <div class:list={["mn-r", { two: a.sub }]}>
                <span class="mn-c">
                  <span class="mn-t">{a.title}</span>
                  {a.sub && <span class="mn-s">{a.sub}</span>}
                </span>
                <span class="mn-k">
                  {a.keys && shortcut(a.keys).map((k) => <i>{k}</i>)}
                  {a.more && <svg class="mn-chev">
                    <use href="#ic-chev" />
                  </svg>}
                </span>
              </div>
            ),
          )}
        </div>
      </div>
      <div class="mb-i">
        <svg class="mb-batt"><use href="#ic-batt"></use></svg>
      </div>
      <div class="mb-i">
        <svg class="mb-wifi"><use href="#ic-wifi"></use></svg>
      </div>
      <div class="mb-i">
        <svg class="mb-cc"><use href="#ic-cc"></use></svg>
      </div>
      <div class="mb-i mb-clock">Tue 13 Oct 20:53</div>
    </div>
    {demo && <svg class="ptr" viewBox="0 0 17 25">
      <path
        class="ptr-p"
        d="M1.5 1.5v18.2l4.4-4.3 3.1 7.2 3.2-1.4-3.1-7.1h6.2Z"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
    </svg>}
  </div>
</div>
