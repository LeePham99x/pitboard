---
import { DOCS, REPO } from "../data/site.ts";
import Lockup from "./Lockup.astro";

interface Props {
  current: "home" | "changelog" | "download" | null;
  stars: number | null;
}
const { current, stars } = Astro.props;
const here = (page: Props["current"]) => (current === page ? "page" : undefined);
const ghLabel = stars === null ? "Pitboard on GitHub" : `Pitboard on GitHub, ${stars} stars`;
const check = "M1.5 6.5 4.6 9.6 10.5 2.4";
const themes = [
  ["system", "System"],
  ["light", "Light"],
  ["dark", "Dark"],
];
---

<header class="site-head">
  <div class="wrap head-in">
    <a class="home" href="/" aria-label="Pitboard home" aria-current={here("home")}><Lockup /></a>
    <nav class="nav" aria-label="Site">
      <a href={DOCS}>Docs</a>
      <a href="/changelog" aria-current={here("changelog")}>Changelog</a>
      <a href="/download" aria-current={here("download")}>Download</a>
      <a class="gh" href={REPO} aria-label={ghLabel}
        ><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg
        ><span>GitHub</span>{stars !== null && <span class="stars">{stars}</span>}</a
      >
      <div class="theme">
        <button
          class="icon-btn theme-btn"
          id="theme-btn"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="theme-menu"
          aria-label="Theme: System"
        >
          <svg class="i i-system" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle
              cx="8"
              cy="8"
              r="6.25"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
            <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor"></path>
          </svg
          ><svg class="i i-light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle
              cx="8"
              cy="8"
              r="3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
            <path
              d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
            ></path>
          </svg
          ><svg class="i i-dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M13.6 10.1A6 6 0 0 1 5.9 2.4a6 6 0 1 0 7.7 7.7Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
        <div class="theme-menu" id="theme-menu" role="menu" aria-label="Theme" hidden>
          {themes.map(([v, name]) => <button
            type="button"
            role="menuitemradio"
            data-v={v}
            aria-checked={v === "system" ? "true" : "false"}
            tabindex="-1"
          >
            <svg class="ck" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path
                d={check}
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="square"
              />
            </svg>
            {name}
          </button>)}
        </div>
      </div>
    </nav>
    <nav class="mnav-n" aria-label="Site">
      <details class="mnav">
        <summary>Menu</summary>
        <div class="mnav-panel">
          <a href={DOCS}>Docs</a>
          <a href="/changelog" aria-current={here("changelog")}>Changelog</a>
          <a href="/download" aria-current={here("download")}>Download</a>
          <a href={REPO} aria-label={ghLabel}
            >GitHub {stars !== null && <span class="stars">{stars}</span>}</a
          >
          <div class="mnav-theme">
            <span id="mnav-theme-l">Theme</span>
            <div class="seg" role="group" aria-labelledby="mnav-theme-l">
              {themes.map(([v, name]) => <button
                type="button"
                data-v={v}
                aria-pressed={v === "system" ? "true" : "false"}
              >
                {name}
              </button>)}
            </div>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>
