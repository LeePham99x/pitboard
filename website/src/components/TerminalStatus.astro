---
import { status } from "../data/terminal.ts";

const text = `<span class="pr">$ </span>pitboard\n${status.join("\n")}`;
---

<figure class="fig sv-cli">
  <div class="term" data-scroll="cap-hero-cli" data-output>
    <pre class="fit" aria-hidden="true" set:html={text} />
  </div>
  <figcaption class="fig-cap" id="cap-hero-cli">
    <span class="vh">The output of <code>pitboard</code>: work is in use, and personal is ready to
      switch to. Each shows its five-hour and weekly usage and pace.
    </span
    >The output of <code>pitboard</code>, with example accounts.
  </figcaption>
</figure>
