---
// With `after`, a click shows the step its platform's [data-after] note gives next.
interface Props {
  platform: "macos" | "windows";
  href: string;
  beta?: boolean;
  after?: boolean;
  class?: string;
}
const { platform, href, beta = false, after = false, class: extra } = Astro.props;
const system = { macos: "Mac", windows: "Windows" }[platform];
---

<a
  class:list={[
    "inline-flex h-12 cursor-pointer items-center justify-center rounded-sm bg-ink px-6 font-mono text-control font-semibold text-on-ink no-underline hover:bg-[color-mix(in_srgb,var(--color-ink)_84%,var(--color-page))]",
    extra,
  ]}
  href={href}
  data-download={after ? platform : undefined}
  >{`Download for ${system}${beta ? " (beta)" : ""}`}</a
>
