---
import { tour } from "../data/terminal.ts";

const blocks = tour.map((step) => {
  const ty = step.command.includes(" --") ? "ty nw" : "ty";
  const command = `<span class="ln"><span class="pr" aria-hidden="true">$ </span><span class="${ty}">${step.command}</span></span>`;
  const lines = step.output
    .map((o) => `<span class="ln"${o.wait ? " data-wait" : ""}>${o.html}</span>`)
    .join("");
  return `<span class="${step.fit ? "tb fit" : "tb"}">${command}${lines}</span>`;
});
const text = `\n${blocks.join("\n")}\n`;
---

<figure class="fig tour sv-cli">
  <div class="term" data-tour data-output>
    <div class="term-ctl">
      <button type="button" data-pause aria-controls="tour-pre">Pause</button
      ><button type="button" data-replay aria-controls="tour-pre">Replay</button>
    </div>
    <pre id="tour-pre" data-scroll="cap-tour" set:html={text} />
  </div>
  <figcaption class="fig-cap" id="cap-tour">Enrolling and switching in the terminal.</figcaption>
</figure>
