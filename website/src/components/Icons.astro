---
import template from "../assets/logo/template.svg?raw";

const paths = [...template.matchAll(/<path d="([^"]+)"[^>]*?(fill-opacity="[^"]+")?\/>/g)];
if (paths.length !== 2) throw new Error("template.svg is not the kit's two paths");
const [board, dim] = paths.map((m) => m[1]);
const dimOpacity = /fill-opacity="([^"]+)"/.exec(template)?.[1] ?? "0.35";

const line = {
  "sf-gear":
    "M10 6.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8ZM8.6 2.5h2.8l.4 2 1.6.9 1.9-.7 1.4 2.4-1.5 1.3v1.9l1.5 1.3-1.4 2.4-1.9-.7-1.6.9-.4 2H8.6l-.4-2-1.6-.9-1.9.7-1.4-2.4 1.5-1.3V8.4L3.3 7.1l1.4-2.4 1.9.7 1.6-.9Z",
  "sf-gauge": "M3 14a7 7 0 1 1 14 0M10 14l-3-4.5M5.4 9.6l1 .6M10 6.2v1.2M14.6 9.6l-1 .6",
  "sf-cal": "M4 4.5h12v11H4ZM4 8h12M7 3v3M13 3v3M13.5 13.5a2.5 2.5 0 1 0 0-.01M13.5 12v1.5h1.2",
  "sf-term": "M3.5 4.5h13v11h-13ZM6.5 8.5l2.2 1.8-2.2 1.8M10 12.5h3.5",
  "sf-down": "M10 3a7 7 0 1 1 0 14 7 7 0 0 1 0-14ZM10 6.5v6.5M7.2 10.3 10 13l2.8-2.7",
  "sf-people":
    "M7.5 9.5a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2ZM2.5 16c.6-2.6 2.6-4 5-4s4.4 1.4 5 4M13.5 9.2a2.2 2.2 0 1 0-.6-4.3M14.5 12.3c1.6.4 2.7 1.6 3 3.7",
  "sf-clock": "M10 6.5V10l2.4 1.6M4.2 7.4A6.3 6.3 0 1 1 3.7 10M2.6 5.6l1.6 1.8 1.9-1.4",
  "sf-steth":
    "M5 3v4.5a3 3 0 0 0 6 0V3M8 10.5v1.8a3.8 3.8 0 0 0 7.6 0v-1M15.6 9.9a1.5 1.5 0 1 0 0-.01",
  "sf-refresh": "M15.6 10A5.6 5.6 0 1 1 13.9 6M14.4 2.8v3.6h-3.6",
  "sf-plus": "M10 4v12M4 10h12",
  "sf-check": "M4.5 10.4 8.2 14l7.3-8.4",
  "sf-chev": "M7.5 4.5 13 10l-5.5 5.5",
  "sf-xmark": "M5 5l10 10M15 5 5 15",
  "sf-person":
    "M10 3a7 7 0 1 1 0 14 7 7 0 0 1 0-14ZM10 6.3a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM5.3 15.2c1-1.6 2.7-2.5 4.7-2.5s3.7.9 4.7 2.5",
};
---

<svg class="absolute size-0 overflow-hidden" aria-hidden="true" focusable="false">
  <symbol id="pb-template" viewBox="0 0 16 16">
    <path d={board} fill="currentColor"></path>
    <path d={dim} fill="currentColor" fill-opacity={dimOpacity}></path>
  </symbol>
  {Object.entries(line).map(([id, d]) => <symbol id={id} viewBox="0 0 20 20">
    <path
      d={d}
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </symbol>)}
  <symbol id="sf-info-fill" viewBox="0 0 20 20">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM10 5.6a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM8.6 9.2v1.2h.8v3.4h-.8V15h2.8v-1.2h-.8V9.2Z"
    ></path>
  </symbol>
  <symbol id="sf-person-fill" viewBox="0 0 20 20">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M10 2.4a7.6 7.6 0 1 1 0 15.2 7.6 7.6 0 0 1 0-15.2ZM10 5.8a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2ZM5.6 15c1-1.5 2.6-2.3 4.4-2.3s3.4.8 4.4 2.3a6.6 6.6 0 0 1-8.8 0Z"
    ></path>
  </symbol>
  <symbol id="ic-batt" viewBox="0 0 25 12">
    <rect
      x=".5"
      y=".5"
      width="21.5"
      height="11"
      rx="3.2"
      fill="none"
      stroke="currentColor"
      stroke-opacity=".45"
    ></rect>
    <rect
      x="22.9"
      y="4"
      width="1.6"
      height="4"
      rx=".8"
      fill="currentColor"
      fill-opacity=".45"
    ></rect>
    <rect x="2" y="2" width="15" height="8" rx="1.8" fill="currentColor"></rect>
  </symbol>
  <symbol id="ic-wifi" viewBox="0 0 16 12">
    <path
      d="M1.3 4.3a9.5 9.5 0 0 1 13.4 0M3.8 6.8a6 6 0 0 1 8.4 0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <circle cx="8" cy="9.9" r="1.5" fill="currentColor"></circle>
  </symbol>
  <symbol id="ic-cc" viewBox="0 0 16 14">
    <rect
      x=".75"
      y="1"
      width="14.5"
      height="5"
      rx="2.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    ></rect>
    <circle cx="3.6" cy="3.5" r="1.5" fill="currentColor"></circle>
    <rect
      x=".75"
      y="8"
      width="14.5"
      height="5"
      rx="2.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    ></rect>
    <circle cx="12.4" cy="10.5" r="1.5" fill="currentColor"></circle>
  </symbol>
</svg>
