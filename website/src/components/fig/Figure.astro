---
// An app figure and, with a `cli` slot, its terminal twin; captions and descriptions are HTML.
import Choice from "./Choice.astro";

interface Side {
  caption: string;
  describe: string;
}
interface Props {
  app: Side;
  cli?: Side;
  class?: string;
  // false where tabs beside the figure already pick, as the hero's install tabs do
  pick?: boolean;
}
const { app, cli, class: extra, pick = true } = Astro.props;
const both = cli !== undefined && Astro.slots.has("cli");
const onApp = both ? "block surface-cli:hidden" : "block";
const onCli = "block surface-app:hidden no-js:mt-6";
---

<figure class:list={["min-w-0", extra]}>
  {both && pick && (
    <Choice
      class="mb-3"
      name="surface"
      label="Show Pitboard as"
      options={[
        ["app", "App"],
        ["cli", "Command line"],
      ]}
    />
  )}
  <div class="@container">
    <div class={onApp}><slot /></div>
    {both && <div class={onCli}>
      <slot name="cli" />
    </div>}
  </div>
  <figcaption class="mt-3.5 font-mono text-ui text-muted [&_code]:text-[1em] [&_code]:text-muted">
    <span class={onApp}
      ><span class="sr-only" set:html={`${app.describe} `} /><span set:html={app.caption}
    /></span>
    {both && <span class={onCli}>
      <span class="sr-only" set:html={`${cli!.describe} `} />
      <span set:html={cli!.caption} />
    </span>}
  </figcaption>
</figure>
