---
// One section of the Limits pane, in LimitsSettings.swift's words.
import Lights from "./Lights.astro";
import Switch from "./Switch.astro";
import { clock } from "../../data/world.ts";

interface Props {
  show: "switch" | "warm";
}
const { show } = Astro.props;
const tabs = [
  ["general", "General", "sf-gear"],
  ["limits", "Limits", "sf-gauge"],
  ["renewal", "Renewal", "sf-cal"],
  ["commandLine", "Command Line", "sf-term"],
  ["updates", "Updates", "sf-down"],
];
const heights = { switch: "min-h-380", warm: "min-h-450" } as const;
const group = "rounded-pt-8 bg-win-bg shadow-group *:not-first:inset-shadow-sep-t";
const row = "flex min-h-36 items-center gap-12 px-10 py-6";
const label = "min-w-0 flex-1";
const small = "block text-pt-12/15 text-win-sub";
const head = "px-10 pb-6 font-bold";
const foot = "px-10 pt-6 text-pt-12/15 text-win-sub";
const control = "rounded-pt-5 bg-win-btn shadow-control";
// two arrows, each a 7 by 4 point fill clipped to a triangle
const stepper = [
  "flex h-21 w-13 flex-col",
  "before:flex-1 before:bg-linear-to-b before:from-win-sub before:to-win-sub before:bg-size-[calc(var(--spacing)*7)_calc(var(--spacing)*4)] before:bg-center before:bg-no-repeat before:[clip-path:polygon(50%_30%,75%_65%,25%_65%)]",
  "after:flex-1 after:bg-linear-to-b after:from-win-sub after:to-win-sub after:bg-size-[calc(var(--spacing)*7)_calc(var(--spacing)*4)] after:bg-center after:bg-no-repeat after:[clip-path:polygon(25%_35%,75%_35%,50%_70%)]",
];
---

<div
  class:list={["desk flex items-center justify-center py-20", heights[show]]}
  aria-hidden="true"
  data-output
>
  <div class="relative w-500 overflow-hidden rounded-pt-12 bg-win-bg text-win-text shadow-window">
    <div class="relative flex justify-center gap-2 bg-win-side pt-30 pb-6 inset-shadow-sep-b">
      <Lights window />
      <span class="absolute inset-x-0 top-7 text-center font-bold">Limits</span>
      {tabs.map(([id, name, icon]) => <span
        class:list={[
          "flex min-w-62 flex-col items-center gap-2 rounded-pt-6 px-4 pt-4 pb-3 text-pt-11/13",
          id === "limits" ? "bg-win-pick text-win-blue" : "text-win-sub",
        ]}
      >
        <svg class="size-22 shrink-0">
          <use href={`#${icon}`} />
        </svg>
        {name}
      </span>)}
    </div>
    <div class="bg-win-form px-20 pt-14 pb-16">
      {show === "switch" && (
        <>
          <p class={head}>Before an account runs out</p>
          <div class={group}>
            <div class={row}>
              <span class={label}>Switch Claude Code automatically</span>
              <Switch on />
            </div>
            <div class={row}>
              <span class={label}>Switch when a limit reaches 95%</span>
              <span class:list={[control, ...stepper]}></span>
            </div>
            <div class={row}>
              <span class:list={[small, "pb-2"]}
                >Watching work: 40% of its weekly limit, as of {clock.read}.</span
              >
            </div>
          </div>
          <p class={foot}>
            Pitboard switches Claude Code to another of your accounts with room below 95% in every
            limit, once a limit of the one in use reaches 95%, while the app is open. Sessions
            already running follow within about 33 seconds. It never switches back by itself, and
            never switches Codex: a running codex keeps its account until restarted.
          </p>
        </>
      )}
      {show === "warm" && (
        <>
          <p class={head}>Warm up limits</p>
          <div class={group}>
            <div class={row}>
              <span class={label}>From</span>
              <span class:list={[control, "px-6 py-1 tabular-nums"]}>07:00</span>
            </div>
            <div class={row}>
              <span class={label}>To</span>
              <span class:list={[control, "px-6 py-1 tabular-nums"]}>23:00</span>
            </div>
            <div class={row}>
              <span class={label}>
                personal · Max 20x<small class={small}>Warms up again at {clock.warmsAgain}</small>
              </span>
              <Switch on />
            </div>
            <div class={row}>
              <span class={label}>work · Max 20x</span>
              <Switch />
            </div>
            <div class={row}>
              <span class:list={[small, "pb-2"]}
                >Next warm-up: personal at {clock.warmsAgain}.</span
              >
            </div>
          </div>
          <p class={foot}>
            Pitboard starts the five-hour period of each account turned on as soon as the last one
            resets, within these hours, while the app is open, so it resets as early as it can.
            Claude Code sends one short request with that account's own login. Pitboard warms up
            Claude Code accounts only, and none with a limit used up.
          </p>
        </>
      )}
    </div>
  </div>
</div>
