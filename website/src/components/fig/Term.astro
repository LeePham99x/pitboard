---
import Terminal from "./Terminal.astro";
import type { Session } from "../../data/sessions.ts";

interface Props {
  session: Session;
}
const { session } = Astro.props;
---

<div class="desk flex min-h-0 items-center justify-center py-20" aria-hidden="true" data-output>
  <Terminal title={session.title} solo>
    <div><span class="text-tw-dim">%</span> {session.command}</div>
    {session.output.map((line) => (
      <div set:html={line || " "} />
    ))}
    <div><span class="text-tw-dim">%</span> <span class="bg-tw-dim"> </span></div>
  </Terminal>
</div>
