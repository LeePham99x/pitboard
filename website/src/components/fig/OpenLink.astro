---
// AccountPicker.swift, with crates/pitboard-ffi/src/present/windows.rs's words.
import Lights from "./Lights.astro";
import MacButton from "./MacButton.astro";

const account = "rounded-pt-5 pt-4 px-8 pb-5";
---

<div class="desk flex min-h-300 items-center justify-center py-20" aria-hidden="true" data-output>
  <div class="relative w-440 overflow-hidden rounded-pt-12 bg-win-bg text-win-text shadow-window">
    <div class="relative h-28 bg-win-side">
      <Lights window />
      <span class="pointer-events-none absolute inset-x-0 top-6 text-center font-bold"
        >Open Link</span
      >
    </div>
    <div class="grid gap-12 p-20">
      <span class="font-bold">Open this claude.ai link as:</span>
      <span class="truncate text-pt-12 text-win-blue"
        >claude.ai/project/0199c2f4-8e3b-7a51-b6d0-4f2e9c7a1d38</span
      >
      <div class="rounded-pt-6 bg-win-bg p-4 shadow-list">
        <div class={account}>
          personal<small class="block text-pt-10/13 text-win-sub">me@example.com</small>
        </div>
        <div class:list={[account, "bg-win-blue text-white"]}>
          work<small class="block text-pt-10/13 text-white/80">me@company.com, window open</small>
        </div>
      </div>
      <div class="flex justify-end gap-8">
        <MacButton>Cancel</MacButton>
        <MacButton default>Open</MacButton>
      </div>
    </div>
  </div>
</div>
