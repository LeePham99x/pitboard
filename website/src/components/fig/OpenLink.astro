---
// AccountPicker.swift, with crates/pitboard-ffi/src/present/windows.rs's words.
---

<div class="desk flow p-link" aria-hidden="true" data-output>
  <div class="mw ol">
    <div class="ol-bar">
      <span class="tl"><i></i><i></i><i></i></span>
      <span class="tw-title">Open Link</span>
    </div>
    <div class="ol-body">
      <span class="ol-h">Open this claude.ai link as:</span>
      <span class="ol-link">claude.ai/project/0199c2f4-8e3b-7a51-b6d0-4f2e9c7a1d38</span>
      <div class="ol-list">
        <div class="ol-acc">personal<small>me@example.com</small></div>
        <div class="ol-acc on">work<small>me@company.com, window open</small></div>
      </div>
      <div class="ol-btns">
        <span class="btn-mac">Cancel</span>
        <span class="btn-mac def">Open</span>
      </div>
    </div>
  </div>
</div>
