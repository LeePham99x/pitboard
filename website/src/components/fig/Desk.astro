---
// MenuBarContent.swift's menu over a Claude Code session; with `demo`, site.ts plays a switch.
import MenuBar from "./MenuBar.astro";
import MenuItem from "./MenuItem.astro";
import Terminal from "./Terminal.astro";
import { session } from "../../data/desk.ts";
import { clock, tools, type Moment } from "../../data/world.ts";
import { isInUse, listed, menuBarTitle, menuLine, menuTitle, statusLine } from "../../lib/words.ts";

interface Props {
  demo?: boolean;
}
const { demo = false } = Astro.props;
const moments: Moment[] = demo ? ["before", "after"] : ["after"];
const actions: ({ title: string; sub?: string; keys?: string; more?: boolean } | null)[] = [
  { title: "Add Account…", keys: "⌘N" },
  { title: "Refresh", sub: `Updated ${clock.read}`, keys: "⌘R" },
  null,
  { title: "Open claude.ai", more: true },
  { title: "Open chatgpt.com", more: true },
  null,
  { title: "Open Pitboard", keys: "⌘0" },
  { title: "Settings…", keys: "⌘," },
  { title: "Check for Updates…" },
  null,
  { title: "About Pitboard" },
  { title: "Pitboard Help" },
  { title: "Quit Pitboard", keys: "⌘Q" },
];
// one state, or both with the moments that show each
// The session's status line follows the switch after the menu does.
const either = (
  before: string,
  after: string,
  was = "hidden demo-before:inline",
  now = "demo-before:hidden",
) =>
  demo && before !== after
    ? `<span class="${was}">${before}</span><span class="${now}">${after}</span>`
    : after;
const row = "relative mx-5 flex items-center rounded-pt-6 py-4 pr-13 pl-25";
const sep = "my-4.5 mr-16 ml-30 h-px bg-mn-sep";
const rule =
  "bg-linear-to-b from-tw-rule to-tw-rule bg-size-[100%_1px] bg-position-[0_50%] bg-no-repeat";
---

<div class="desk h-668" id={demo ? "demo" : undefined} aria-hidden="true" data-output>
  <Terminal title="claude" class="top-156 bottom-14 left-14 w-416">
    {session.map((line) => (
      <div set:html={line} />
    ))}
    <div class={rule}></div>
    <div>&gt; <span class="bg-tw-dim"> </span></div>
    <div class={rule}></div>
    <div
      set:html={
        "  " +
        either(statusLine("before"), statusLine("after"), "hidden demo:inline", "demo:hidden")
      }
    />
  </Terminal>
  <MenuBar clock={clock.menuBar}>
    <div class="relative">
      <MenuItem on class="demo-shut:bg-transparent">
        <svg class="size-16 shrink-0"><use href="#pb-template"></use></svg>
        <span set:html={either(menuBarTitle("before"), menuBarTitle("after"))} />
      </MenuItem>
      <div
        class="absolute top-26 left-0 w-max rounded-pt-10 bg-mn-bg py-5 whitespace-nowrap text-mn-text normal-nums shadow-menu backdrop-blur-xl backdrop-saturate-180 transition-opacity duration-200 demo-shut:opacity-0"
      >
        {moments.map((moment) => <div
          class:list={[
            { "hidden demo-before:block": demo && moment === "before" },
            { "demo-before:hidden": demo && moment === "after" },
          ]}
        >
          {tools.map(([tool, name], i) => (
            <>
              {i > 0 && <div class={sep} />}
              <div class="pt-4.5 pr-18 pb-4 pl-30 text-pt-11 font-bold text-mn-dim">{name}</div>
              {listed(tool, moment).map((a) => {
                const pick = demo && moment === "before" && tool === "claude" && a.label === "work";
                return <div
                  class:list={[
                    row,
                    "pt-3",
                    {
                      "bg-mn-hl text-white demo-moving:bg-transparent demo-moving:text-inherit":
                        pick,
                    },
                  ]}
                >
                  {isInUse(a, moment) && <svg
                    class="absolute top-1/2 left-7 -mt-6 size-12 shrink-0"
                  >
                    <use href="#sf-check" />
                  </svg>}
                  <span class="flex-1">
                    <span class="block">{menuTitle(a)}</span>
                    <span
                      class:list={[
                        "block text-pt-11/15",
                        pick ? "text-inherit demo-moving:text-mn-sub" : "text-mn-sub",
                      ]}
                    >
                      {menuLine(a, moment)}
                    </span>
                  </span>
                </div>;
              })}
            </>
          ))}
        </div>)}
        <div class={sep}></div>
        {actions.map((a) =>
          a === null ? (
            <div class={sep} />
          ) : (
            <div class:list={[row, { "pt-3": a.sub }]}>
              <span class="flex-1">
                <span class="block">{a.title}</span>
                {a.sub && <span class="block text-pt-11/15 text-mn-sub">{a.sub}</span>}
              </span>
              <span
                class="ml-24 grid grid-cols-[calc(var(--spacing)*12)_calc(var(--spacing)*10)] text-mn-dim"
              >
                {a.keys &&
                  [...a.keys].map((k, j) => <i class:list={["not-italic", { "text-center": j > 0 }]}
                    >{k}</i
                  >)}
                {a.more && <svg class="col-start-2 size-10 shrink-0 justify-self-end text-mn-sub">
                  <use href="#sf-chev" />
                </svg>}
              </span>
            </div>
          ),
        )}
      </div>
    </div>
  </MenuBar>
  {demo && <svg
    class="pointer-events-none absolute top-12 left-300 z-3 h-21 w-14 origin-[1px_1px] transition-transform duration-800 ease-out demo-start:-translate-x-53 demo-start:translate-y-40 demo-row:translate-x-72 demo-row:translate-y-100 demo-pick:scale-86 demo-pick:duration-100"
    viewBox="0 0 17 25"
  >
    <path
      class="fill-black stroke-white"
      d="M1.5 1.5v18.2l4.4-4.3 3.1 7.2 3.2-1.4-3.1-7.1h6.2Z"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
  </svg>}
</div>
