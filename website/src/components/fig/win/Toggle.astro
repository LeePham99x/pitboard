---
// WinUI's ToggleSwitch as a settings card shows it: On or Off, then a 40 by 20 pixel pill.
interface Props {
  on?: boolean;
}
const { on = false } = Astro.props;
---

<span class="flex items-center gap-12">
  {on ? "On" : "Off"}
  <span
    class:list={[
      "relative h-20 w-40 flex-none rounded-pill after:absolute after:top-4 after:size-12 after:rounded-circle",
      on
        ? "bg-win-accent after:left-24 after:bg-win-on-accent"
        : "bg-win-toggle-off inset-shadow-win-strong after:left-4 after:bg-win-text-2",
    ]}
  ></span>
</span>
