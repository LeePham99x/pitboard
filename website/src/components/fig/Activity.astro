---
// The Activity pane, with the entries sessions.ts's `pitboard log` prints, in the app's words.
import PitboardWindow from "./PitboardWindow.astro";
import { clock } from "../../data/world.ts";

const rows = [
  [`13 Oct 2026 at ${clock.switched}`, "Switch", "work", "Pitboard app"],
  [`13 Oct 2026 at ${clock.warmed}`, "Warm-up", "personal", "Pitboard app"],
  ["10 Oct 2026 at 09:16", "Enrol", "work", "Command line"],
  ["10 Oct 2026 at 09:14", "Enrol", "personal", "Command line"],
];
const th = "px-6 py-5 text-left font-normal text-win-sub inset-shadow-sep-b";
---

<PitboardWindow pane="activity" title="Activity" tools={["sf-refresh"]}>
  <table class="w-full border-collapse text-pt-12/15 whitespace-nowrap tabular-nums">
    <thead>
      <tr>
        <th class={th}>Date</th>
        <th class={th}>Change</th>
        <th class={th}>Account</th>
        <th class={th}>Result</th>
        <th class={th}>Asked By</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(([date, change, account, by]) => <tr class="*:px-6 *:py-4 even:*:bg-win-stripe">
        <td>{date}</td>
        <td>{change}</td>
        <td>{account}</td>
        <td class="text-win-sub">Done</td>
        <td class="text-win-sub">{by}</td>
      </tr>)}
    </tbody>
  </table>
</PitboardWindow>
