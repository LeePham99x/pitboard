---
// Bar lengths are classes in home.css: the CSP allows no style attribute.
interface Limit {
  key: "5h" | "week";
  used: number;
  pace: number | null;
  resets: string;
  paceText: string;
  over?: boolean;
}
interface Account {
  name: string;
  plan: string;
  mail: string;
  inUse: boolean;
  limits: Limit[];
  note?: string;
}
const groups: { tool: string; accounts: Account[] }[] = [
  {
    tool: "Claude Code",
    accounts: [
      {
        name: "personal",
        plan: "Max 20x",
        mail: "me@example.com",
        inUse: true,
        limits: [
          { key: "5h", used: 59, pace: 77, resets: "resets in 1h 10m", paceText: "18% under pace" },
          {
            key: "week",
            used: 73,
            pace: 18,
            resets: "resets in 5d 18h",
            paceText: "55% over pace",
            over: true,
          },
        ],
        note: "Weekly limit runs out in 11h 05m at this pace",
      },
      {
        name: "work",
        plan: "Team 5x",
        mail: "me@company.com",
        inUse: false,
        limits: [
          { key: "5h", used: 12, pace: 39, resets: "resets in 3h 02m", paceText: "27% under pace" },
          {
            key: "week",
            used: 40,
            pace: 69,
            resets: "resets in 2d 4h",
            paceText: "29% under pace",
          },
        ],
      },
    ],
  },
  {
    tool: "Codex",
    accounts: [
      {
        name: "main",
        plan: "Pro",
        mail: "dana@work.example",
        inUse: true,
        limits: [
          { key: "5h", used: 18, pace: 33, resets: "resets in 3h 19m", paceText: "15% under pace" },
          {
            key: "week",
            used: 7,
            pace: 17,
            resets: "resets in 5d 18h",
            paceText: "10% under pace",
          },
        ],
      },
      {
        name: "spare",
        plan: "Pro",
        mail: "dana@home.example",
        inUse: false,
        limits: [{ key: "5h", used: 0, pace: null, resets: "resets in 5h 00m", paceText: "" }],
      },
    ],
  },
];
const head = "M4.5 17.3c1.4-2.3 3.8-3.6 6.5-3.6s5.1 1.3 6.5 3.6A9 9 0 0 1 11 20a9 9 0 0 1-6.5-2.7Z";
const tick = "M1.5 6.5 4.6 9.6 10.5 2.4";
---

<div class="win" aria-hidden="true" data-output>
  <div class="win-bar">
    <span class="win-tl"><i></i><i></i><i></i></span>
    <span class="win-title"><b>Accounts</b><span>Updated 20:52</span></span>
    <span class="win-tools"
      ><svg viewBox="0 0 16 16">
        <path
          d="M13.2 8A5.2 5.2 0 1 1 11.6 4.3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        ></path>
        <path
          d="M12.2 1.6v3.2H9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg
      ><svg viewBox="0 0 16 16">
        <path
          d="M8 2.5v11M2.5 8h11"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        ></path>
      </svg></span
    >
  </div>
  <div class="win-body">
    {groups.map((g) => (
      <>
        <p class="win-sec">{g.tool}</p>
        {g.accounts.map((a) => <div class="acct">
          {a.inUse ? (
            <span class="acct-ic in">
              <svg viewBox="0 0 22 22">
                <circle cx="11" cy="11" r="10" fill="currentColor" />
                <circle class="pi" cx="11" cy="8.4" r="3.5" />
                <path class="pi" d={head} />
              </svg>
            </span>
          ) : (
            <span class="acct-ic">
              <svg viewBox="0 0 22 22">
                <circle
                  cx="11"
                  cy="11"
                  r="9.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <circle
                  cx="11"
                  cy="8.6"
                  r="3.2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <path
                  d="M5 17.1c1.4-2 3.5-3.1 6-3.1s4.6 1.1 6 3.1"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
            </span>
          )}
          <span class="acct-id">
            <span class="acct-name">
              {a.name}
              <span class="acct-plan">{a.plan}</span>
            </span>
            <span class="acct-mail">{a.mail}</span>
          </span>
          {a.inUse ? (
            <span class="acct-end">
              <svg viewBox="0 0 12 12">
                <path
                  d={tick}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              In Use
            </span>
          ) : (
            <span class="acct-use">Use</span>
          )}
          <div class="lims">
            {a.limits.map((l) => (
              <>
                <span class="lim-k">{l.key}</span>
                <span
                  class:list={[
                    "bar",
                    `v-${l.used}`,
                    l.pace !== null && `m-${l.pace}`,
                    { "warn over": l.over },
                  ]}
                >
                  <i />
                  {l.pace !== null && <b />}
                </span>
                <span class="lim-pct">{l.used}%</span>
                <span class="lim-more">
                  <span>{l.resets}</span>
                  <span class:list={{ over: l.over }}>{l.paceText}</span>
                </span>
              </>
            ))}
          </div>
          {a.note && <p class="acct-note">{a.note}</p>}
        </div>)}
      </>
    ))}
  </div>
</div>
