---
// One of several features in a section, its figure on the side `flip` says.
interface Props {
  id: string;
  title: string;
  flip?: boolean;
}
const { id, title, flip = false } = Astro.props;
---

<div
  class:list={[
    "mt-14 grid items-center gap-x-12 max-xl:mt-12 max-xl:grid-cols-[minmax(0,1fr)]",
    flip ? "grid-cols-[minmax(0,7fr)_minmax(0,5fr)]" : "grid-cols-[minmax(0,5fr)_minmax(0,7fr)]",
  ]}
  aria-labelledby={id}
  role="group"
>
  <div class:list={{ "order-2 max-xl:order-none": flip }}>
    <h3 class="text-h3 text-strong" id={id}>{title}</h3>
    <div class="prose mt-3"><slot /></div>
  </div>
  <div class="min-w-0 max-xl:mt-8"><slot name="fig" /></div>
</div>
