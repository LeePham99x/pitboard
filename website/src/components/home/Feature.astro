---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="pt-(--block-space)" aria-labelledby={`${id}-title`} id={id}>
  <div class="wrap">
    <div
      class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-x-12 border-t border-rule pt-(--block-in) max-xl:grid-cols-[minmax(0,1fr)]"
    >
      <div>
        <h2 class="font-mono text-h2 text-balance text-strong max-sm:text-h2-sm" id={`${id}-title`}>
          {title}
        </h2>
        <div class="prose mt-6"><slot /></div>
      </div>
      <div class="min-w-0 max-xl:mt-8"><slot name="fig" /></div>
    </div>
  </div>
</section>
