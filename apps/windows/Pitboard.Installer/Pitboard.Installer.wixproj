<Project Sdk="WixToolset.Sdk">
  <!-- Pitboard.msi for one architecture, from Pitboard.App's Release publish and pitboard.exe. Builds on Windows only. -->
  <PropertyGroup>
    <OutputName>Pitboard</OutputName>
    <!-- The owner accepted WiX v7's Open Source Maintenance Fee EULA on 2026-10-15. -->
    <AcceptEula>wix7</AcceptEula>
    <!-- PitboardShare.exe and its package go in only when the package is signed, since only a signed one registers. -->
    <PitboardShareSigned Condition="'$(PitboardShareSigned)' != 'true'">false</PitboardShareSigned>
    <DefineConstants>ProductVersion=$(PitboardMsiVersion);App=$(PitboardApp);CommandLine=$(PitboardCommandLine);ShareSigned=$(PitboardShareSigned)</DefineConstants>
    <!--
      ICE61 warns that MajorUpgrade replaces the same version, which AllowSameVersionUpgrades asks for: a beta and
      its final share three fields. ICE33 warns of pitboard://'s verb in the Registry table, warnings Microsoft calls
      obsolete, and a URL scheme has no table of its own. ICE03 refuses the File table's languages for WinUI's own
      files: its MUI files for ug-CN, mi-NZ and gd-gb, whose primary language is past 0x7F, and the list Windows
      Installer reads from Microsoft.ui.xaml.dll and Microsoft.UI.Xaml.Phone.dll, longer than the column's 20 characters.
    -->
    <SuppressIces>ICE03;ICE33;ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
  <Target Name="CheckPitboardMsiInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(PitboardApp)' == '' or '$(PitboardCommandLine)' == ''" Text="Pass the Release publish of Pitboard.App as PitboardApp and its pitboard.exe as PitboardCommandLine." />
    <Error Condition="'$(PitboardMsiVersion)' == ''" Text="Pass the msi line .github/scripts/windows-versions.sh prints for Cargo.toml's version as PitboardMsiVersion." />
  </Target>
</Project>
