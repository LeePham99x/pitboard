<Project Sdk="MSTest.Sdk">
  <!-- Reads the MSI CI built through msi.dll, and loads the pitboard_ffi.dll of the administrative image it extracted: Windows only, and nothing is installed. -->
  <PropertyGroup>
    <!-- The owner accepted WiX v7's Open Source Maintenance Fee EULA on 2026-10-15. -->
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pitboard.Core/Pitboard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PitboardMsi" Value="$(PitboardMsi)" />
    <AssemblyMetadata Include="PitboardMsiImage" Value="$(PitboardMsiImage)" />
    <AssemblyMetadata Include="PitboardShareSigned" Value="$(PitboardShareSigned)" />
  </ItemGroup>
</Project>
