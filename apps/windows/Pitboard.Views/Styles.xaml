<?xml version="1.0" encoding="utf-8"?>
<!-- Merged after XamlControlsResources, whose styles these extend. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="CriticalCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
  <!-- A check's level: the shapes differ as well as the colours. -->
  <Style x:Key="PassedMarkStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>
  <Style x:Key="WarningMarkStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="FailedMarkStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>
  <!-- The WinUI Gallery's settings page: a section's header over its cards, 4 epx between cards. -->
  <Style x:Key="SettingsSectionHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="1,30,0,6" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>
  <x:Double x:Key="SettingsCardSpacing">4</x:Double>
  <!-- A card in a SettingsExpander's ItemsHeader or ItemsFooter, drawn as the toolkit draws one of its items. -->
  <Style x:Key="SettingsExpanderItemCardStyle" TargetType="toolkit:SettingsCard">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="58,8,44,8" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
</ResourceDictionary>
