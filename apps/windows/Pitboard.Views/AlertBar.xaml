<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.AlertBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <InfoBar x:Name="Bar" AutomationProperties.AutomationId="alert" Closing="OnClosing">
    <StackPanel x:Name="Answers" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
      <Button x:Name="ConfirmButton" Click="OnConfirm" />
      <Button Content="Cancel" Click="OnCancel" />
    </StackPanel>
  </InfoBar>
</UserControl>
