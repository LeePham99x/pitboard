<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pitboard.Views.ActivityPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Pitboard.Core"
    NavigationCacheMode="Required">
  <Page.Resources>
    <Style x:Key="Done" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
  </Page.Resources>
  <!-- NavigationView's guidance: 24 epx sides, 12 in Minimal, which the main window sets. -->
  <Grid Padding="0,16,0,0" RowSpacing="24">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Sides">
        <VisualState x:Name="Wide" />
        <VisualState x:Name="Minimal">
          <VisualState.Setters>
            <Setter Target="Heading.Margin" Value="12,0,12,0" />
            <Setter Target="Columns.Margin" Value="12,0,12,0" />
            <Setter Target="Lines.Padding" Value="12,0,12,16" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="Heading" Margin="24,0,24,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Activity" Style="{StaticResource PageTitleTextBlockStyle}" />
      <CommandBar
          Grid.Column="1"
          VerticalAlignment="Center"
          Background="Transparent"
          DefaultLabelPosition="Right"
          OverflowButtonVisibility="Collapsed">
        <AppBarButton
            Label="Refresh"
            ToolTipService.ToolTip="Read the log again"
            AutomationProperties.AutomationId="activity.refresh"
            Click="OnRefresh">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Refresh" />
          </AppBarButton.Icon>
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
            <KeyboardAccelerator Key="R" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
      </CommandBar>
    </Grid>
    <Grid Grid.Row="1" RowSpacing="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- A list with column headers is how WinUI shows a table. The padding is a list item's own. -->
      <Grid x:Name="Columns" Margin="24,0,24,0" Padding="16,0,12,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Date" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="1" Text="Change" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="2" Text="Account" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="3" Text="Result" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="4" Text="Asked by" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
      <ListView
          x:Name="Lines"
          Grid.Row="1"
          Padding="24,0,24,16"
          SelectionMode="None"
          AutomationProperties.AutomationId="activity"
          AutomationProperties.Name="Activity"
          ContainerContentChanging="OnContainerContentChanging">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="core:ActivityLine">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind Date}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
              <TextBlock Grid.Column="1" Text="{x:Bind Change}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
              <TextBlock Grid.Column="2" Text="{x:Bind Account}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
              <TextBlock x:Name="ResultText" Grid.Column="3" Text="{x:Bind Result}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
              <TextBlock
                  Grid.Column="4"
                  Text="{x:Bind AskedBy}"
                  VerticalAlignment="Center"
                  TextWrapping="WrapWholeWords"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <StackPanel
        x:Name="Empty"
        Grid.Row="1"
        MaxWidth="440"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12"
        Visibility="Collapsed">
      <FontIcon
          x:Name="EmptyMark"
          Glyph="&#xE81C;"
          FontSize="40"
          IsTextScaleFactorEnabled="False"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
      <TextBlock
          x:Name="EmptyDetail"
          HorizontalAlignment="Center"
          Style="{StaticResource BodyTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>
