<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.AccountRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="AccountMark" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="InUseMark" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Over" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="Plenty" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="Low" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="Out" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="OverPace" TargetType="Rectangle">
      <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="UnderPace" TargetType="Rectangle">
      <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid Padding="0,10" ColumnSpacing="12" RowSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="28" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <FontIcon x:Name="Mark" FontSize="20" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <Border
            x:Name="PlanTag"
            VerticalAlignment="Center"
            Padding="6,0"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}">
          <TextBlock x:Name="PlanText" Style="{StaticResource Secondary}" TextWrapping="NoWrap" />
        </Border>
      </StackPanel>
      <TextBlock x:Name="EmailText" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Grid Grid.Column="2" VerticalAlignment="Center">
      <ProgressRing x:Name="SwitchingRing" Width="16" Height="16" IsActive="False" AutomationProperties.Name="Switching" />
      <StackPanel x:Name="InUseLabel" Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="In Use" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Button x:Name="ActionButton" Click="OnAction" />
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
      <Grid x:Name="Limits" ColumnSpacing="8" RowSpacing="4" />
      <StackPanel x:Name="Notes" Spacing="2" />
    </StackPanel>
  </Grid>
</UserControl>
