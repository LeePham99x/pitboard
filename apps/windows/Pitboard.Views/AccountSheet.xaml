<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pitboard.Views.AccountSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    CloseButtonText="Cancel"
    AutomationProperties.AutomationId="sheet"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    Closing="OnClosing"
    Opened="OnOpened"
    PreviewKeyDown="OnPreviewKeyDown">
  <ContentDialog.Resources>
    <Style x:Key="HeldBack" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </ContentDialog.Resources>
  <!-- The InfoBars stay in the tree while closed, so Narrator hears each as it opens; outside the spaced stack, a closed one takes no room. -->
  <StackPanel MinWidth="320">
    <ContentControl x:Name="AlertSpace" HorizontalContentAlignment="Stretch" IsTabStop="False" />
    <StackPanel Spacing="12">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <ProgressRing
            x:Name="Waiting"
            Grid.Column="1"
            Width="20"
            Height="20"
            VerticalAlignment="Top"
            IsActive="False"
            Visibility="Collapsed" />
      </Grid>
      <ComboBox
          x:Name="ToolPicker"
          Header="Tool"
          HorizontalAlignment="Stretch"
          AutomationProperties.AutomationId="sheet.tool"
          SelectionChanged="OnToolChanged" />
      <TextBox x:Name="AccountField" Header="Account" IsReadOnly="True" />
      <TextBox
          x:Name="NameField"
          Header="Name"
          AutomationProperties.AutomationId="sheet.name"
          TextChanged="OnNameChanged" />
      <StackPanel x:Name="Working" Orientation="Horizontal" Spacing="8">
        <ProgressRing Width="20" Height="20" IsActive="True" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="WorkingText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel x:Name="Lines" Spacing="8" />
      <StackPanel x:Name="Link" Spacing="8">
        <TextBlock Text="Sign-in page" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="CopyLink" Content="Copy link" Click="OnCopyLink" />
          <Button x:Name="OpenLink" Content="Open" Click="OnOpenLink" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="CodePart" Spacing="8">
        <TextBox
            x:Name="CodeField"
            Header="Code"
            PlaceholderText="Paste the code from your browser"
            AutomationProperties.AutomationId="sheet.code"
            TextChanged="OnCodeChanged" />
        <TextBlock x:Name="Refused" TextWrapping="Wrap" />
        <TextBlock x:Name="CodeNote" Style="{StaticResource Note}" />
      </StackPanel>
    </StackPanel>
    <InfoBar
        x:Name="MissingBar"
        Severity="Warning"
        IsClosable="False"
        IsOpen="False"
        AutomationProperties.AutomationId="sheet.missing">
      <InfoBar.ActionButton>
        <HyperlinkButton x:Name="MissingLink" AutomationProperties.AutomationId="sheet.missing.link" Click="OnMissingLink" />
      </InfoBar.ActionButton>
    </InfoBar>
    <InfoBar
        x:Name="FailureBar"
        Severity="Error"
        IsClosable="False"
        IsOpen="False"
        AutomationProperties.AutomationId="sheet.failure">
      <StackPanel x:Name="Warnings" Margin="0,0,0,12" Spacing="4" />
    </InfoBar>
  </StackPanel>
</ContentDialog>
