<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.AccountsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views"
    xmlns:shown="using:Pitboard.Windows">
  <UserControl.Resources>
    <Style x:Key="Prominent" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
  </UserControl.Resources>
  <Grid RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="16,0,0,0">
      <TextBlock
          x:Name="Updated"
          VerticalAlignment="Center"
          Style="{StaticResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <CommandBar
          HorizontalAlignment="Right"
          Background="Transparent"
          DefaultLabelPosition="Right"
          OverflowButtonVisibility="Collapsed">
        <AppBarButton
            x:Name="RefreshButton"
            Label="Refresh"
            ToolTipService.ToolTip="Read every account’s usage again"
            AutomationProperties.AutomationId="accounts.refresh"
            Click="OnRefresh">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Refresh" />
          </AppBarButton.Icon>
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
            <KeyboardAccelerator Key="R" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton
            Label="Add Account"
            ToolTipService.ToolTip="Sign in to another account and park its login"
            KeyboardAcceleratorTextOverride="Ctrl+N"
            AutomationProperties.AutomationId="accounts.add"
            Click="OnAdd">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Add" />
          </AppBarButton.Icon>
        </AppBarButton>
      </CommandBar>
    </Grid>
    <ListView
        x:Name="AccountList"
        Grid.Row="1"
        SelectionMode="Single"
        AutomationProperties.AutomationId="accounts"
        AutomationProperties.Name="Accounts"
        ContainerContentChanging="OnContainerContentChanging"
        ContextRequested="OnContextRequested"
        DoubleTapped="OnDoubleTapped">
      <ListView.Header>
        <StackPanel Padding="16,0,12,8" Spacing="8">
          <StackPanel x:Name="Notices" Spacing="8" />
          <InfoBar x:Name="Setup" IsClosable="False" AutomationProperties.AutomationId="setup">
            <InfoBar.IconSource>
              <FontIconSource x:Name="SetupIcon" Glyph="&#xE8AB;" />
            </InfoBar.IconSource>
            <InfoBar.Content>
              <StackPanel x:Name="SetupChoices" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8" />
            </InfoBar.Content>
          </InfoBar>
        </StackPanel>
      </ListView.Header>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shown:ShownAccount">
          <local:AccountRow Item="{x:Bind Item, Mode=OneWay}" />
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate x:DataType="shown:ShownSection">
              <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
    </ListView>
    <StackPanel
        x:Name="Empty"
        Grid.Row="1"
        MaxWidth="440"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12"
        Visibility="Collapsed">
      <FontIcon
          x:Name="EmptyMark"
          FontSize="40"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          AutomationProperties.AccessibilityView="Raw" />
      <ProgressRing x:Name="EmptyProgress" IsActive="False" />
      <TextBlock
          x:Name="EmptyTitle"
          HorizontalAlignment="Center"
          Style="{StaticResource SubtitleTextBlockStyle}"
          TextAlignment="Center" />
      <TextBlock
          x:Name="EmptyDetail"
          HorizontalAlignment="Center"
          Style="{StaticResource BodyTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextAlignment="Center" />
      <Button x:Name="EmptyChoice" HorizontalAlignment="Center" Click="OnEmptyChoice" />
    </StackPanel>
  </Grid>
</UserControl>
