<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pitboard.Views.MachinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Pitboard.Core"
    xmlns:local="using:Pitboard.Views"
    xmlns:shown="using:Pitboard.Windows"
    NavigationCacheMode="Required">
  <Page.Resources>
    <!-- A detail's own copy would keep the marks that wrap its paths; this one copies what it says. -->
    <MenuFlyout x:Key="DetailMenu" Opening="OnDetailMenuOpening">
      <MenuFlyoutItem Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Click="OnCopyDetail">
        <MenuFlyoutItem.Icon>
          <SymbolIcon Symbol="Copy" />
        </MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Select all" KeyboardAcceleratorTextOverride="Ctrl+A" Click="OnSelectAllDetail">
        <MenuFlyoutItem.Icon>
          <SymbolIcon Symbol="SelectAll" />
        </MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
    </MenuFlyout>
  </Page.Resources>
  <Grid Padding="0,16,0,0" RowSpacing="24">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Sides">
        <VisualState x:Name="Wide" />
        <VisualState x:Name="Minimal">
          <VisualState.Setters>
            <Setter Target="PageHeader.Margin" Value="{StaticResource PageHeaderMarginMinimal}" />
            <Setter Target="Lines.Padding" Value="{StaticResource PageContentPaddingMinimal}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="PageHeader" Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="This PC" Style="{StaticResource PageTitleTextBlockStyle}" />
        <!-- When the checks were made, where Accounts says when it read them. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressRing
              Width="16"
              Height="16"
              IsActive="{x:Bind ViewModel.Checking, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.Checking, Mode=OneWay}"
              AutomationProperties.Name="Checking" />
          <TextBlock Text="{x:Bind ViewModel.Checked, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
        </StackPanel>
      </StackPanel>
      <CommandBar
          Grid.Column="1"
          VerticalAlignment="Center"
          Background="Transparent"
          DefaultLabelPosition="Right"
          OverflowButtonVisibility="Collapsed">
        <AppBarButton
            Label="Check again"
            ToolTipService.ToolTip="Make every check again"
            IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
            AutomationProperties.AutomationId="machine.check"
            Click="OnCheckAgain">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Refresh" />
          </AppBarButton.Icon>
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
            <KeyboardAccelerator Key="R" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
      </CommandBar>
    </Grid>
    <ListView
        x:Name="Lines"
        Grid.Row="1"
        Padding="{StaticResource PageContentPadding}"
        SelectionMode="None"
        ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
        AutomationProperties.AutomationId="checks"
        AutomationProperties.Name="Checks">
      <!-- Doctor's last line over the checks, scrolling with them. -->
      <ListView.Header>
        <InfoBar
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasSummary, Mode=OneWay}"
            Title="{x:Bind ViewModel.Summary, Mode=OneWay}"
            Severity="{x:Bind local:MachinePage.Severity(ViewModel.Level), Mode=OneWay}"
            AutomationProperties.AutomationId="machine.summary" />
      </ListView.Header>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <!-- Microsoft's item templates: a three-line item, its name, what it looked at, and what to do. -->
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="core:CheckLine">
          <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="LevelMark"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                FontSize="16"
                IsTextScaleFactorEnabled="False"
                Glyph="{x:Bind local:MachinePage.LevelGlyph(Level)}"
                Style="{x:Bind local:MachinePage.LevelStyle(Level)}"
                AutomationProperties.Name="{x:Bind SpokenLevel}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" />
              <TextBlock
                  Text="{x:Bind shown:PathText.Shown(Detail)}"
                  Style="{StaticResource SecondaryTextBlockStyle}"
                  IsTextSelectionEnabled="True"
                  ContextFlyout="{StaticResource DetailMenu}"
                  SelectionFlyout="{x:Null}"
                  PreviewKeyDown="OnDetailKeyDown" />
              <TextBlock
                  Text="{x:Bind shown:PathText.Shown(Advice)}"
                  Visibility="{x:Bind local:MachinePage.Said(Advice)}"
                  Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <local:EmptyState
        Grid.Row="1"
        Busy="True"
        Visibility="{x:Bind ViewModel.Waiting, Mode=OneWay}"
        Title="{x:Bind ViewModel.WaitingText, Mode=OneWay}" />
  </Grid>
</Page>
