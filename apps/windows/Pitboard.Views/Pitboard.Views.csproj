<Project Sdk="Microsoft.NET.Sdk">
  <!-- The main window's panes, in a library so the WinUI test app shows them as Pitboard.exe does. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pitboard.Core/Pitboard.Core.csproj" />
    <ProjectReference Include="../Pitboard.Windows/Pitboard.Windows.csproj" />
  </ItemGroup>
</Project>
