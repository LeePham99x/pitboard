<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- dotnet format cannot load a WinUI project without its XAML, so the build holds .editorconfig's style. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- A lock file holds the graph of each runtime it names, so both are named wherever a project restores. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- nuget.org alone: the library-packs of a source-built SDK, such as Homebrew's, hold an ILCompiler that differs from nuget.org's. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>
</Project>
