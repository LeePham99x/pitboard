<Project Sdk="MSTest.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Pitboard.Core/Pitboard.Core.csproj" />
  </ItemGroup>
  <!--
    The core itself, built by Cargo: pass its path as PitboardNativeLibrary, such as
    target/release/libpitboard_ffi.so, and it is copied beside the tests to be loaded.
  -->
  <ItemGroup Condition="'$(PitboardNativeLibrary)' != ''">
    <None Include="$(PitboardNativeLibrary)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!--
    Where that library was built as a release is, without the cfg pitboard_unreleased_windows,
    pass PitboardNativeLibraryGated=true as well, for the test of what it refuses on Windows.
  -->
  <ItemGroup Condition="'$(PitboardNativeLibraryGated)' == 'true'">
    <AssemblyMetadata Include="PitboardNativeLibraryGated" Value="true" />
  </ItemGroup>
</Project>
