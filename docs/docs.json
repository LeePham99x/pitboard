{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pitboard",
  "description": "Switch Claude Code, Codex and Claude Desktop between your own accounts without signing out, and see what each Claude Code and Codex account has left.",
  "colors": {
    "primary": "#166534",
    "light": "#4DD170",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Install and remove",
        "pages": [
          "install",
          "install/other-ways",
          "install/verify",
          "install/upgrade-from-0-3-0",
          "install/remove"
        ]
      },
      {
        "group": "Use Pitboard",
        "pages": [
          "guides/accounts",
          "guides/switch",
          "guides/usage",
          "guides/automatic-switching",
          "guides/warm-up",
          "guides/status-line",
          "guides/claude-code",
          "guides/codex",
          "guides/claude-desktop",
          "guides/renewal",
          "guides/sign-in-again",
          "guides/account-windows"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting",
          "troubleshooting/accounts",
          "troubleshooting/claude-desktop",
          "troubleshooting/recovery",
          "troubleshooting/account-windows"
        ]
      },
      {
        "group": "How it works",
        "pages": [
          "concepts/switching",
          "concepts/identity",
          "concepts/claude-desktop",
          "concepts/open-sessions",
          "concepts/usage",
          "security",
          "concepts/account-windows",
          "concepts/limits"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          {
            "group": "Commands",
            "root": "reference/commands",
            "pages": [
              "reference/account-commands",
              "reference/maintenance-commands",
              "reference/recovery-commands",
              "reference/integration-commands"
            ]
          },
          "reference/account-status",
          "reference/json-output",
          "reference/errors",
          "reference/files",
          "reference/app",
          "reference/account-windows",
          "reference/settings",
          "reference/automatic-switching"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Download",
          "href": "https://usepitboard.com/download",
          "icon": "download"
        },
        {
          "anchor": "Changelog",
          "href": "https://usepitboard.com/changelog",
          "icon": "scroll-text"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/datlechin/pitboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/datlechin/pitboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "search": {
    "prompt": "Search the docs"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.usepitboard.com"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "Go back to the [introduction](/)."
    }
  }
}
